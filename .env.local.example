# Mercado Pago API Keys
# Obtén tus claves desde: https://www.mercadopago.com.ar/developers/panel/app

# Access Token (Token de acceso)
# Encuéntralo en: Tu aplicación > Credenciales de producción o Credenciales de prueba
MERCADOPAGO_ACCESS_TOKEN=TU_ACCESS_TOKEN_AQUI

# URL base de tu aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nota: Para producción, usa las credenciales de producción
# Para pruebas, usa las credenciales de prueba (sandbox)
